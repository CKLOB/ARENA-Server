# Required: Base64-encoded 32-byte-or-longer HMAC key.
JWT_SECRET=

# Optional JWT lifetime overrides. Defaults are PT15M, P14D, and PT10M.
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P14D
JWT_ONBOARDING_TOKEN_EXPIRATION=PT10M

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI_WEB=
GOOGLE_OAUTH_REDIRECT_URI_IOS=
GOOGLE_OAUTH_REDIRECT_URI_ANDROID=

# Kakao OAuth
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI_WEB=

# Apple OAuth. APPLE_PRIVATE_KEY may use literal \n line breaks in dotenv.
APPLE_OAUTH_IOS_CLIENT_ID=
APPLE_OAUTH_ANDROID_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_OAUTH_ANDROID_REDIRECT_URI=
